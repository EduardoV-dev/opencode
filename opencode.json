{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "openai": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  },
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "instructions": [
    "~/.config/opencode/instructions/general/*.md"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/.agents/skills"
    ]
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/.agents/skills/**": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "mcp": {
    "chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ]
}
